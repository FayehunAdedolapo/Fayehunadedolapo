      <column caption='New tweet created' datatype='datetime' name='[Calculation_703687508073046016]' role='dimension' type='ordinal'>
        <calculation class='tableau' formula='DATETIME(DATEADD(&apos;hour&apos;,CEILING(DATEPART(&apos;minute&apos;,[tweet_created])/60.0),DATETRUNC(&apos;hour&apos;,[tweet_created])))' />
